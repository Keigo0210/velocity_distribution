{
  "base_profile_audit_config": "audit_inlet_upstream_profile.json",
  "section_library": "sections.json",
  "section_series": {
    "name_prefix": "inlet_development",
    "template_section": "upstream_z30",
    "axis": "z",
    "positions_mm": [49.5, 49.0, 48.0, 45.0, 40.0, 35.0, 30.0],
    "center_x_mm": 0.0,
    "center_y_mm": 0.0,
    "normal": [0.0, 0.0, 1.0],
    "flow_direction_normal": [0.0, 0.0, -1.0],
    "inlet_position_mm": 50.0,
    "diameter_mm": 10.0,
    "valid_internal_position_range_mm": [30.0, 49.999]
  },
  "position_sensitivity": {
    "enabled": true,
    "base_positions_mm": [49.5, 49.0, 48.0],
    "offsets_mm": [-0.05, 0.0, 0.05],
    "flow_change_warning_percent": 1.0,
    "beta_alpha_change_warning_percent": 2.0,
    "l2_change_warning_percentage_points": 2.0
  },
  "existing_boundary_audit": {
    "profile_metrics_summary": "../output/inlet_upstream_profile_audit/re100/profile_metrics_summary.csv",
    "common_grid_metrics": "../output/inlet_upstream_profile_audit/re100/common_grid_metrics.csv",
    "audit_json": "../output/inlet_upstream_profile_audit/re100/inlet_upstream_profile_audit.json"
  },
  "profile": {
    "low_velocity_fraction_of_mean": 0.1,
    "fully_developed_beta": 1.3333333333333333,
    "fully_developed_alpha": 2.0
  },
  "integration": {
    "minimum_polygon_area_mm2": 1.0e-12
  },
  "interpolation": {
    "method": "linear_tri_point_visualization",
    "star_cell_to_point_for_visualization": true,
    "valid_mask": "both solvers finite at all four grid-cell vertices",
    "minimum_common_valid_area_fraction_percent": 50.0
  },
  "decision_thresholds": {
    "large_profile_l2_percent": 5.0,
    "small_profile_l2_percent": 3.0,
    "increase_warning_percentage_points": 2.0
  },
  "plot": {
    "x_axis": "distance_mm",
    "dpi": 180,
    "cmap": "viridis",
    "difference_cmap": "coolwarm"
  },
  "execution": {
    "refuse_nonempty_output_directory": true
  },
  "output": {
    "directory": "../output/inlet_development_profile_audit/re100",
    "save_common_grid_npz": true,
    "save_section_figures": true,
    "save_development_figures": true,
    "save_position_sensitivity_figures": true
  }
}
